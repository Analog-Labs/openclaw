# Dockerfile.production — Pocodot production gateway image
# Multi-stage: builds from patched source (pocodot branch), then creates a
# lean alpine runtime image.  Includes all Pocodot plugins baked in.
# Built by: .github/workflows/deploy-openclaw-production.yml

# ── Stage 1: Build from patched source ──────────────────────────
FROM node:22-bookworm AS build

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /app

# Copy manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc openclaw.mjs ./
COPY ui/package.json ./ui/
COPY patches ./patches
COPY scripts/postinstall-bundled-plugins.mjs \
     scripts/preinstall-package-manager-warning.mjs \
     scripts/npm-runner.mjs \
     scripts/windows-cmd-helpers.mjs \
     ./scripts/

RUN NODE_OPTIONS=--max-old-space-size=2048 pnpm install --frozen-lockfile

# Copy full source (after install to leverage cache)
COPY . .

# Stub A2UI canvas bundle (requires Bun; not needed for gateway)
RUN mkdir -p src/canvas-host/a2ui && \
    echo "/* A2UI stub */" > src/canvas-host/a2ui/a2ui.bundle.js && \
    echo "stub" > src/canvas-host/a2ui/.bundle.hash && \
    rm -rf vendor/a2ui apps/shared/OpenClawKit/Tools/CanvasA2UI

# Build gateway (tsdown + postbuild steps)
RUN pnpm build:docker

# Pack into installable tarball
RUN npm pack && mv openclaw-*.tgz /tmp/openclaw-patched.tgz

# ── Stage 2: Lean runtime ───────────────────────────────────────
ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine

ARG OPENCLAW_DOCKER_APT_PACKAGES="git"

# Install patched openclaw from build stage
COPY --from=build /tmp/openclaw-patched.tgz /tmp/
RUN npm install -g /tmp/openclaw-patched.tgz && rm /tmp/openclaw-patched.tgz

# Install extra packages (git needed for workspace operations)
RUN if [ -n "$OPENCLAW_DOCKER_APT_PACKAGES" ]; then \
      apk add --no-cache $OPENCLAW_DOCKER_APT_PACKAGES; \
    fi

# Install npm plugins from registry
RUN npm install -g openclaw-whatsapp-cloud-api@1.1.0 \
    @martian-engineering/lossless-claw@0.9.2

# Create home directory and extensions directory for openclaw user
RUN mkdir -p /home/openclaw/extensions/node_modules && chown -R node:node /home/openclaw

# Copy custom plugins (source only, no node_modules)
COPY --chown=node:node pocodot-extensions/openclaw-sendblue /home/openclaw/extensions/node_modules/openclaw-sendblue
COPY --chown=node:node pocodot-extensions/billing-usage-tracker /home/openclaw/.openclaw/extensions/billing-usage-tracker

# Install sendblue dependencies
RUN cd /home/openclaw/extensions/node_modules/openclaw-sendblue && npm install --omit=dev

# Symlinks so extensions can resolve the openclaw package
RUN mkdir -p /usr/lib/node_modules \
    && ln -s /usr/local/lib/node_modules/openclaw /usr/lib/node_modules/openclaw
RUN mkdir -p /node_modules \
    && ln -s /usr/local/lib/node_modules/openclaw /node_modules/openclaw

# Symlink npm plugins into extensions path
RUN ln -s /usr/local/lib/node_modules/openclaw-whatsapp-cloud-api \
      /home/openclaw/extensions/node_modules/openclaw-whatsapp-cloud-api \
    && mkdir -p /home/openclaw/.openclaw/extensions \
    && ln -s /usr/local/lib/node_modules/@martian-engineering/lossless-claw \
      /home/openclaw/.openclaw/extensions/lossless-claw

ENV NODE_PATH=/usr/local/lib/node_modules
ENV HOME=/home/openclaw

USER node
WORKDIR /home/openclaw

EXPOSE 18789

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD wget -qO- http://127.0.0.1:18789/health || exit 1

CMD ["openclaw", "gateway", "--port", "18789", "--allow-unconfigured"]
